@startuml AutoMarket-Comportamiento
title Diagrama de comportamiento - Publicar, aprobar y consultar un vehículo
autonumber
skinparam shadowing false

actor V as Vendedor
participant UI as "Interfaz web"
participant API as "Backend Go/Gin (HTTPS)"
participant S as Servicio
participant M as "Almacén de imágenes"
database D as "PostgreSQL"
participant Sesiones as "Sesiones en memoria"
database L as "audit.jsonl"
actor A as Administrador
actor X as Visitante

V -> UI : Envía formulario de registro
UI -> API : POST /api/sellers
API -> S : Registrar vendedor
S -> D : Guardar usuario
API -> L : Registrar operación
API --> UI : 201 Created

V -> UI : Inicia sesión
UI -> API : POST /api/sessions
API -> S : Validar credenciales
S -> D : Buscar usuario
S -> Sesiones : Crear token
API --> UI : Token Bearer

V -> UI : Completa datos y carga fotos
UI -> API : POST /api/vehicles + token (multipart)
API -> Sesiones : Autenticar token
API -> API : Autorizar rol seller
API -> S : Validar datos y portada
S -> M : Validar que sean JPG/PNG y guardar
S -> D : Guardar estado pending e imágenes
API -> L : Registrar operación
API --> UI : 201 + publicación pendiente

A -> API : GET /api/admin/vehicles/pending + token
API -> Sesiones : Autenticar token
API -> API : Autorizar rol admin
API -> S : Consultar pendientes
S -> D : Leer vehículos, imágenes y vendedores
API -> L : Registrar operación
API --> A : Lista de pendientes

A -> API : POST /api/admin/vehicles/{id}/approve
API -> S : Aprobar publicación
S -> D : Cambiar estado a published
API -> L : Registrar operación
API --> A : 204 No Content

X -> UI : Abre el catálogo sin registrarse
UI -> API : GET /api/vehicles
API -> S : Consultar publicados
S -> D : Leer vehículos y vendedores
API -> L : Registrar operación
API --> UI : Catálogo, imágenes y contacto del vendedor
@enduml
