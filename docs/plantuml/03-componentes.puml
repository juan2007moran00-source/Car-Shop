@startuml AutoMarket-Componentes
title 3. Componentes del backend - AutoMarket
left to right direction
skinparam shadowing false
skinparam componentStyle rectangle

component "Navegador / cliente HTTP" as Client

package "Backend Go + Gin" {
    component "Rutas, handlers y\nautorización\ninternal/httpapi" as HTTP
    component "Reglas del sistema\ninternal/service" as Service
    component "Modelos\ninternal/domain" as Domain
    component "Persistencia JSON\ninternal/store" as Store
    component "Auditoría\ninternal/audit" as AuditModule
}

database "data/automarket.json" as Data
database "data/audit.jsonl" as Log

Client --> HTTP : HTTP
HTTP --> Service : Solicitudes válidas
Service --> Domain : Usa modelos
Service --> Store : Lee y guarda
Store --> Data : JSON
HTTP --> AuditModule : Registra operaciones
AuditModule --> Log : JSONL
@enduml
