@startuml AutoMarket-Contenedores
title 2. Contenedores C4 - AutoMarket
left to right direction
skinparam shadowing false
skinparam componentStyle rectangle

actor Visitante
actor Vendedor
actor Administrador

package "AutoMarket" {
    component "Interfaz web\nHTML, CSS y JavaScript\nNavegador" as Web
    component "Backend HTTP / API REST\nGo + Gin" as API
    database "Datos\ndata/automarket.json" as Data
    database "Auditoría\ndata/audit.jsonl" as Audit
}

Visitante --> Web : Consulta
Vendedor --> Web : Registro y publicación
Web --> API : HTTP / JSON
API --> Web : Sirve páginas y archivos
Administrador --> API : Rutas REST protegidas
API --> Data : Lee y guarda
API --> Audit : Registra solicitudes

note bottom of Web
  No hay panel visual de administrador.
end note
@enduml
