@startuml AutoMarket-Publicar-Aprobar
title 6. Publicar y aprobar un vehículo
autonumber
skinparam shadowing false

actor V as Vendedor
participant UI as "Interfaz web"
participant API as "Backend Go/Gin"
participant S as Servicio
database D as "automarket.json"
participant Sesiones as "Sesiones en memoria"
database L as "audit.jsonl"
actor A as Administrador
actor X as Visitante

V -> UI : Envía formulario de registro
UI -> API : POST /api/sellers
API -> S : Registrar vendedor
S -> D : Guardar usuario
API -> L : Registrar operación
API --> UI : 201 Created

V -> UI : Inicia sesión
UI -> API : POST /api/sessions
API -> S : Validar credenciales
S -> D : Buscar usuario
S -> Sesiones : Crear token
API --> UI : Token Bearer

V -> UI : Publica vehículo
UI -> API : POST /api/vehicles + token
API -> Sesiones : Validar token y rol seller
API -> S : Crear publicación
S -> D : Guardar estado pending
API -> L : Registrar operación
API --> UI : 201 + publicación pendiente

A -> API : Inicia sesión y obtiene token
A -> API : GET /api/admin/vehicles/pending
API -> Sesiones : Validar token y rol admin
API -> S : Consultar pendientes
S -> D : Leer vehículos
API --> A : Lista de pendientes

A -> API : POST /api/admin/vehicles/{id}/approve
API -> Sesiones : Validar token y rol admin
API -> S : Aprobar publicación
S -> D : Cambiar estado a published
API -> L : Registrar operación
API --> A : 204 No Content

X -> UI : Abre el catálogo
UI -> API : GET /api/vehicles
API -> S : Consultar publicados
S -> D : Leer vehículos y vendedores
API -> L : Registrar consulta
API --> UI : Catálogo y contacto del vendedor
@enduml
