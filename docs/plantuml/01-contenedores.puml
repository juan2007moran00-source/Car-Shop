@startuml AutoMarket-Contenedores
title AutoMarket - Diagrama C4 de contenedores
left to right direction

skinparam shadowing false
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultTextAlignment center
skinparam ArrowColor #385170
skinparam actorStyle awesome

actor Visitante
actor Vendedor
actor Administrador

package "Sistema AutoMarket" {
    component "Interfaz web\n<<Container>>\nHTML, CSS y JavaScript\nSe ejecuta en el navegador" as Web
    component "Backend HTTP / API REST\n<<Container>>\nGo + Gin\nRutas, reglas y seguridad AAA" as API
    database "Almacén de datos\n<<Container>>\ndata/automarket.json\nUsuarios y vehículos" as Data
    database "Bitácora de auditoría\n<<Container>>\ndata/audit.jsonl\nEventos encadenados con SHA-256" as Audit
}

Visitante --> Web : Consulta catálogo
Vendedor --> Web : Se registra, inicia sesión\ny publica vehículos
Web --> API : HTTP / JSON
API --> Web : Sirve páginas y\narchivos estáticos
Administrador --> API : Rutas REST protegidas\ncon token Bearer
API --> Data : Lee y guarda datos JSON
API --> Audit : Registra solicitudes HTTP

note bottom of Web
  La interfaz y la API son responsabilidades
  separadas; Gin sirve la interfaz al navegador.
end note

note bottom of Administrador
  No hay panel visual de administración.
  El administrador usa las rutas REST.
end note

@enduml
